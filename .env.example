# ============================================
# ZovaoDoBob — Environment Variables
# ============================================
# Copy this file to .env and fill in the real values:
#   cp .env.example .env
# .env is gitignored — never commit real tokens.

# ── Slack (required) ─────────────────────────────────────────────────
# Bot User OAuth Token.
# Slack app → OAuth & Permissions → Bot User OAuth Token (starts with xoxb-).
SLACK_BOT_TOKEN=

# App-Level Token for Socket Mode.
# Slack app → Basic Information → App-Level Tokens.
# Required scope: connections:write (starts with xapp-).
SLACK_APP_TOKEN=

# The bot's own user ID — used to ignore the bot's own messages.
# Slack app → auth.test, or the member ID of the bot user (starts with U or B).
SLACK_BOT_USER_ID=

# ── Triage (required) ────────────────────────────────────────────────
# Comma-separated Slack user IDs allowed to run triage admin actions.
TRIAGE_ADMIN_USERS=

# ── Optional ─────────────────────────────────────────────────────────
REFINEMENT_MODE=llm
TRIAGE_MODE=llm
ISSUE_MODE=llm

# região watsonx.ai (ou eu-de, etc.)
LLM_BASE_URL=
LLM_API_KEY=
# watsonx model_id (ou ibm/granite-3-1-8b-instruct)
LLM_MODEL=
LLM_AUTH_STYLE=
LLM_TEAM_ID=
LLM_PROJECT_ID=

CODE_INTELLIGENCE_PROVIDER=
GRAPHIFY_REPO_PATH=