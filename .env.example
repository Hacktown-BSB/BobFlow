# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# ─── LLM ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=mock
WATSONX_API_KEY=...
OPENAI_API_KEY=...

# ─── Services (orchestration service calls these) ─────────────────────────────
